# Supabase project used by both the storefront and this administration console.
# Never put real credentials in this example file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-only-key

# At least 32 random characters. Generate and store this in the deployment's
# secret manager; changing it invalidates every administrator session.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Navigation only. The console never calls the storefront API.
STOREFRONT_URL=https://store.example.com

# Leave unset for a directly exposed local Node process. Vercel is detected and
# uses one trusted proxy hop automatically. For another controlled reverse
# proxy, set the exact positive hop count (usually 1). Values other than a
# positive integer, 0, true, or false are rejected at boot.
# TRUST_PROXY=1

# Order notifications (see modules/orders/services/order-notifications.service.js).
# Every one of these is optional: leave it unset and that channel is silently
# skipped rather than failing the order update it was attached to.

# WhatsApp Cloud API (business-initiated messages require pre-APPROVED message
# templates in Meta Business Manager — see core/notifications/whatsapp-client.js).
# WHATSAPP_ACCESS_TOKEN=replace-with-a-meta-cloud-api-access-token
# WHATSAPP_PHONE_NUMBER_ID=replace-with-the-sending-number-id
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_CONFIRMED=order_confirmed
# WHATSAPP_TEMPLATE_SHIPPED=order_shipped
# WHATSAPP_TEMPLATE_CANCELLED=order_cancelled
# WHATSAPP_TEMPLATE_REFUNDED=refund_completed

# Email fallback, via Resend (resend.com).
# RESEND_API_KEY=replace-with-a-resend-api-key
# NOTIFICATIONS_FROM_EMAIL=orders@yourdomain.com

# The one courier this business ships through (no per-order courier picker —
# see order-notifications.service.js). {trackingId} is replaced with whatever
# AWB an admin enters; leave the URL template unset and the message still
# names the tracking id, just without a clickable link.
# SHIPPING_COURIER_NAME=Delhivery
# SHIPPING_TRACKING_URL_TEMPLATE=https://www.delhivery.com/track/package/{trackingId}
