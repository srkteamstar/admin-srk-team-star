# Supabase project used by both the storefront and this administration console.
# Never put real credentials in this example file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-only-key

# At least 32 random characters. Generate and store this in the deployment's
# secret manager; changing it invalidates every administrator session.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Navigation only. The console never calls the storefront API.
STOREFRONT_URL=https://store.example.com

# Leave unset for a directly exposed local Node process. Vercel is detected and
# uses one trusted proxy hop automatically. For another controlled reverse
# proxy, set the exact positive hop count (usually 1). Values other than a
# positive integer, 0, true, or false are rejected at boot.
# TRUST_PROXY=1
