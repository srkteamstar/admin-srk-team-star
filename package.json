{
  "name": "srk-admin-console",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build-vercel-public.js",
    "verify": "npm --prefix backend run verify",
    "test": "npm --prefix backend test",
    "test:build": "node --test tools/build-vercel-public.test.js",
    "test:browser:built": "node tools/test-built-browser.js",
    "test:all": "npm run test:build && npm --prefix backend run test:all && npm run test:browser:built"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
